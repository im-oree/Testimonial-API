# ============================================================
# Testimonial API — environment template (apps/api)
# Copy to .env for local runs. All keys are OPTIONAL for a
# skeleton boot; the pieces that need them fail lazily on use.
# ============================================================

# ---- Deployment mode: PROD / LIVE env toggle (2026-09-08) -----
# APP_MODE=prod (default) — the current product environment.
#   Engine follows DATABASE_PROVIDER below:
#     firebase = prototype/demo (NEVER used for live traffic)
#     postgres = SQL backend (set once it is production-ready)
# APP_MODE=live — the real launch environment. PostgreSQL ONLY
#   (Firebase is never used for live). Requires DATABASE_PROVIDER
#   (auto-postgres) and DATABASE_URL; boot fails fast without them.
# APP_MODE=prod
# DATABASE_PROVIDER=firebase

# ---- Firebase (APP_MODE=prod with DATABASE_PROVIDER=firebase) --
# Point at the (gitignored) service-account file for your Firebase
# project. Emulator mode: FIRESTORE_EMULATOR_HOST=localhost:8080
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.prod.json
# GCLOUD_PROJECT=testimonial-api-64e85

# ---- Postgres / SQL (APP_MODE=live, or prod+postgres) ---------
# DATABASE_URL=postgresql://user:pass@host:5432/testimonial_api

# ---- Postgres (used when DATABASE_PROVIDER=postgres) ---------
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/testimonial_api

# ---- Firestore (used when DATABASE_PROVIDER=firebase) --------
# Local emulator: `npm run emulators` then uncomment:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# GCLOUD_PROJECT=demo-testimonial
# Production creds:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---- Server ---------------------------------------------------
PORT=3000
NODE_ENV=development

# ---- Redis (cache / rate limit / queue / realtime) ------------
# REDIS_URL=redis://localhost:6379

# ---- Secrets (Doc 2/6 harden these) ----------------------------
# JWT_SECRET=change-me
# SESSION_COOKIE_SECRET=change-me

# ---- Third-party (all optional in skeleton) -------------------
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
# H_CAPTCHA_SITE_KEY=
# H_CAPTCHA_SECRET_KEY=
# GCS_BUCKET_NAME=

# ---- AI Service Engine (Doc 2 Additive A) ---------------------
# Provider API keys are NEVER plaintext at rest: ai_providers.api_key_encrypted
# holds a KMS blob. Dev/emulator/CI blobs use mock:// (no key), env:VAR or
# plain: — production rows use gcp-kms:<keyName>|<b64 ciphertext>.
# Provider rows are managed from the platform "AI Providers" dashboard (Doc 2
# core); the engine only needs these process knobs:
# AI_HEALTH_JOB_ENABLED=true          # false disables the 2-min circuit job
# AI_HEALTH_CHECK_INTERVAL_MS=120000  # circuit-breaker recovery cadence
# GOOGLE_OAUTH_ACCESS_TOKEN=          # GCP KMS REST auth (or run on GCE)
# VENDOR defaults for real providers (rows may override via base_url/settings):
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_VERSION=2023-06-01
# AZURE_OPENAI_BASE_URL=              # https://<res>.openai.azure.com/openai/deployments/<dep>
# AZURE_OPENAI_API_VERSION=2024-06-01
# CUSTOM_LLM_BASE_URL=                # OpenAI-compatible self-hosted endpoint

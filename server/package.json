{
  "name": "testimonial-api-server",
  "version": "0.1.0",
  "private": true,
  "description": "Plain Node.js + Express backend for the testimonial platform (in-memory demo data).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:security": "node --import tsx --test test/security.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

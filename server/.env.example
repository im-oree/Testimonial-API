# ── API server configuration ────────────────────────────────────────────────
# Copy this file to server/.env and adjust. Every value has a sane default,
# so the app runs with NO .env file at all (that's the demo experience).
#
#   cp .env.example .env
#
# Real environment variables always beat values in this file.

# Port the API listens on. The Vite dev proxy (client/.env) must match.
# default: 3000
PORT=3000

# Bind address. 0.0.0.0 = all interfaces (containers / sandboxes);
# use 127.0.0.1 to keep it local-only.
# default: 0.0.0.0
HOST=0.0.0.0

# Session token signing. Leave both unset and the server auto-generates a
# secret and persists it to server/.session-secret (tokens survive restarts).
#   SESSION_SECRET      — set an inline secret instead (12-factor deploys
#                         where the filesystem is read-only). Recommended: 64+
#                         hex chars, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
#   SESSION_SECRET_FILE — where the auto-generated secret is stored.
#SESSION_SECRET=
#SESSION_SECRET_FILE=.session-secret

# Cross-origin access for the API. Off by default — the web app talks to the
# API same-origin (Vite proxies /v1 to it in dev). Set this only when a
# frontend deployed on ANOTHER domain points at this API (its VITE_API_BASE).
#   one origin:  CORS_ORIGINS=https://app.example.com
#   several:     CORS_ORIGINS=https://a.example.com,https://b.example.com
#   dev free-for-all: CORS_ORIGINS=*
#CORS_ORIGINS=

+          <pre className="code-block" style={{ marginTop: 8 }}><code>{codeBlocks[codeTab].code}</code></pre>
+          <div style={{ display: 'flex', gap: 8, alignItems: 'center', marginTop: 10, flexWrap: 'wrap' }}>

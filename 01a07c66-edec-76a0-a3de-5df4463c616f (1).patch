+import { SkeletonTable } from '../components/Skeleton';
+
+type Filter = 'all' | 'pending' | 'approved' | 'rejected' | 'archived';
+
+const FILTERS: Filter[] = ['all', 'pending', 'approved', 'rejected', 'archived'];
+const PAGE_SIZE = 10;

+// ============================================================
+// Testimonial API — Prisma schema (Postgres adapter)
+//
+// Canonical, hand-reviewable DDL lives in infra/postgres/schema.sql
+// and is THE production source of truth (docs/01-skeleton.md §6).
+// This file mirrors it 1:1 for the Postgres adapter + local dev
+// (prisma migrate/db push), with documented deviations:
+//
+//   • audit_logs is a plain table here — PRODUCTION partitions it
+//     monthly per infra/postgres/schema.sql. Prisma queries against
+//     the partitioned parent table work unchanged.
+//   • updated_at triggers come from schema.sql (not Prisma); every
+//     repository.update() also sets updatedAt explicitly.
+//   • FK constraints are declared in schema.sql only (single source);
+//     Prisma models stay column-mirrors (relation-free) on purpose so
+//     mapper translation is the one and only place data shape is owned.
+//
+// Column naming = snake_case (native); domain entities are camelCase;
+// per-entity mappers in ./mappers/* translate.
+// ============================================================
+
+generator client {
+  provider = "prisma-client-js"
+}
+
+datasource db {
+  provider = "postgresql"
+  url      = env("DATABASE_URL")
+}
+
+// ---------- enums (mirror infra/postgres/schema.sql) ----------
+enum tenant_status {
+  active
+  suspended
+  pending_setup
+}
+
+enum plan_tier {
+  free
+  starter
+  pro
+  enterprise
+}
+
+enum tenant_role {
+  owner
+  admin
+  editor
+  contributor
+  viewer
+}
+
+enum platform_role {
+  owner
+  admin
+  support
+  billing
+  developer
+  read_only
+}
+
+enum staff_status {
+  invited
+  active
+  disabled
+}
+
+enum app_status {
+  active
+  disabled
+}
+
+enum api_key_type {
+  public
+  secret
+}
+
+enum api_key_env {
+  live
+  test
+}
+
+enum api_key_status {
+  active
+  revoked
+  expired
+}
+
+enum testimonial_source {
+  manual
+  form
+  api
+  twitter_import
+  csv_import
+}
+
+enum testimonial_status {
+  pending
+  approved
+  rejected
+  archived
+}
+
+enum rating_type {
+  star5
+  nps
+  thumbs
+  none
+}
+
+enum template_type {
+  widget
+  form
+}
+
+enum widget_layout {
+  carousel
+  grid
+  wall
+  spotlight
+  badge
+  video_wall
+}
+
+enum form_status {
+  draft
+  active
+  paused
+}
+
+enum question_type {
+  text
+  textarea
+  rating
+  video
+  photo
+  select
+}
+
+enum integration_provider {
+  twitter
+  google_reviews
+  producthunt
+  slack
+  zapier
+  webhook
+}
+
+enum integration_status {
+  connected
+  error
+  disabled
+}
+
+enum webhook_status {
+  active
+  disabled
+}
+
+enum delivery_status {
+  pending
+  success
+  failed
+  retrying
+}
+
+enum invite_scope {
+  platform
+  tenant
+}
+
+enum actor_type {
+  platform_admin
+  tenant_staff
+  api_key
+  system
+}
+
+enum auth_provider {
+  password
+  google
+  magic_link
+}
+
+// ---- AI Service Engine (Doc 2 Additive A) ----
+enum ai_provider_type {
+  openai
+  groq
+  gemini
+  anthropic
+  azure_openai
+  custom
+  mock
+}
+
+enum ai_provider_status {
+  active
+  disabled
+  rate_limited
+  error
+}
+
+enum ai_task_type {
+  classify_testimonial
+  summarize
+  translate
+  extract_sentiment
+  detect_spam
+  generate_reply
+  custom
+}
+
+enum ai_routing_strategy {
+  round_robin
+  weighted
+  failover
+  cheapest
+  fastest
+  single
+}
+
+enum ai_request_status {
+  success
+  error
+  timeout
+  rate_limited
+  low_confidence
+  human_override
+}
+
+// ---------- identity ----------
+model User {
+  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
+  email               String   @unique @db.Citext
+  password_hash       String?
+  name                String
+  avatar_url          String?
+  auth_provider       auth_provider @default(password)
+  mfa_enabled         Boolean  @default(false)
+  mfa_secret_encrypted String?
+  email_verified_at   DateTime?
+  created_at          DateTime @default(now()) @db.Timestamptz(6)
+  updated_at          DateTime @default(now()) @db.Timestamptz(6)
+
+  @@map("users")
+}
+
+model PlatformAdmin {
+  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
+  user_id            String   @unique @db.Uuid
+  role               platform_role @default(read_only)
+  permissions        String[] @default([])
+  status             staff_status @default(invited)
+  two_factor_enabled Boolean  @default(false)
+  last_login_at      DateTime? @db.Timestamptz(6)
+  invited_by         String?  @db.Uuid
+  created_at         DateTime @default(now()) @db.Timestamptz(6)
+
+  @@map("platform_admins")
+}
+
+model Plan {
+  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
+  tier                      plan_tier @unique
+  name                      String
+  price_cents               Int      @default(0)
+  max_apps                  Int
+  max_testimonials_per_month Int
+  max_seats                 Int
+  features                  Json     @default("{}")

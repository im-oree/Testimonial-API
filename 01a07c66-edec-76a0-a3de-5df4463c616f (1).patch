+
+  /** Structural hard-delete (admin/maintenance only) — business flow archives. */
+  override async deleteHard(id: string): Promise<void> {
+    await this.col().doc(id).delete();
+  }
+
+  findByPublicId(publicId: string): Promise<App | null> {

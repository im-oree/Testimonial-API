+            <p style={{ margin: 0 }}>
+              <strong>{rows.find((r) => r.id === confirmDelete)?.name}</strong> will be removed from the catalogue. Products that adopted it
+              keep their current look — only the template entry disappears. This cannot be undone.
+            </p>
+          ) : null
+        }

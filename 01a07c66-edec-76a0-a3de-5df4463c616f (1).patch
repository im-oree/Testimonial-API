+    if (session.kind === 'platform') {
+      const user = DEMO.platformUsers().find((u) => u.email === session.email)!;
+      return {
+        user: { id: user.id, email: user.email, name: user.name, avatarUrl: null, role: user.role },
+        tenant: null,
+        permissions: [],
+        permissionsVersion: 1,

+    --border: 220 13% 91%;              /* slate-200 */
+    --border-subtle: 220 14% 96%;       /* slate-100 */
+    --border-strong: 215 16% 47%;       /* slate-500, focus rings */
+
+    /* ── Brand Accent (default: Indigo) ─────────────── */

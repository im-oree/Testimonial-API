+/**
+ * Doc 5 §2 — root theme tokens (light :root + dark .dark), verbatim.
+ * Every component references these via Tailwind color tokens (§1), so the
+ * white-label engine (§9) re-themes the whole app by overriding --primary-*.
+ */
+@tailwind base;
+@tailwind components;
+@tailwind utilities;
+
+@layer base {
+  :root {
+    /* ── Neutrals (Light Mode) ─────────────────────── */
+    --background: 0 0% 100%;
+    --background-subtle: 220 14% 96%;
+    --background-muted: 220 13% 91%;
+    --background-elevated: 0 0% 100%;
+
+    --foreground: 222 47% 11%;
+    --foreground-secondary: 215 16% 47%;
+    --foreground-tertiary: 215 20% 65%;
+    --foreground-inverse: 0 0% 100%;
+
+    --border: 220 13% 91%;
+    --border-subtle: 220 14% 96%;
+    --border-strong: 215 16% 47%;
+
+    /* ── Brand Accent (default: Indigo #4F46E5) ────── */
+    --primary-50: 226 100% 97%;
+    --primary-100: 226 100% 94%;
+    --primary-200: 228 96% 89%;
+    --primary-300: 230 94% 82%;
+    --primary-400: 234 89% 74%;
+    --primary-500: 239 84% 67%;
+    --primary-600: 243 75% 59%;
+    --primary-700: 245 58% 51%;
+    --primary-800: 244 55% 41%;
+    --primary-900: 242 47% 34%;
+    --primary-950: 240 40% 20%;
+
+    /* ── Misc ──────────────────────────────────────── */
+    --ring: var(--primary-500);
+    --radius: 0.75rem;
+  }
+
+  .dark {
+    /* ── Neutrals (Dark Mode) ──────────────────────── */
+    --background: 222 47% 6%;
+    --background-subtle: 222 47% 9%;
+    --background-muted: 217 33% 17%;
+    --background-elevated: 222 47% 11%;
+
+    --foreground: 210 40% 98%;
+    --foreground-secondary: 215 20% 65%;
+    --foreground-tertiary: 215 16% 47%;
+    --foreground-inverse: 222 47% 11%;
+
+    --border: 217 33% 17%;
+    --border-subtle: 222 47% 9%;
+    --border-strong: 215 20% 65%;
+
+    --primary-50: 226 50% 12%;
+    --primary-100: 228 50% 16%;
+    --primary-200: 230 50% 22%;
+    --primary-300: 232 60% 32%;
+    --primary-400: 236 70% 50%;
+    --primary-500: 239 84% 67%;
+    --primary-600: 243 75% 59%;
+    --primary-700: 245 58% 51%;
+    --primary-800: 244 55% 41%;
+    --primary-900: 242 47% 34%;
+    --primary-950: 240 40% 20%;
+
+    --ring: var(--primary-400);
+  }
+
+  * {
+    box-sizing: border-box;
+  }
+
+  html {
+    -webkit-font-smoothing: antialiased;
+  }
+
+  body {
+    margin: 0;
+    background-color: hsl(var(--background-subtle));
+    color: hsl(var(--foreground));
+  }
+
+  /* Doc 5 §6.5 — respect OS reduced-motion */
+  @media (prefers-reduced-motion: reduce) {
+    *, *::before, *::after {
+      animation-duration: 0.01ms !important;
+      animation-iteration-count: 1 !important;
+      transition-duration: 0.01ms !important;
+    }
+  }
+}
+
+/* Doc 5 §12 — print styles */
+@media print {
+  .sidebar, .topbar, .impersonation-banner, .notification-bell { display: none !important; }
+  .main-content { margin: 0 !important; padding: 0 !important; }
+  .card { break-inside: avoid; box-shadow: none !important; border: 1px solid #ddd !important; }
+  body { color: #000 !important; background: #fff !important; }
+}

+/* Widget design library styles — shared motions & layout tricks used by the
+   plug-and-play designs in ./designs. Everything else is inline per design. */
+
+/* Generic card lift used by grid-ish designs */
+.wdg-hover:hover {
+  box-shadow: 0 12px 24px -10px rgba(22, 26, 46, 0.16);
+  transform: translateY(-3px);
+}
+
+/* Wall of love masonry */
+.wdg-masonry {
+  columns: 3 210px;
+  column-gap: 12px;
+}
+.wdg-masonry-item {
+  margin: 0 0 12px;
+  width: 100%;
+}
+@media (max-width: 560px) {
+  .wdg-masonry { columns: 2 150px; }
+}
+@media (max-width: 380px) {
+  .wdg-masonry { columns: 1 130px; }
+}
+
+/* Marquee strips */
+.wdg-marquee {
+  overflow: hidden;
+  padding: 6px 0;
+  -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
+  mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
+}
+.wdg-marquee-top { margin-bottom: 10px; }
+.wdg-marquee-track {
+  display: flex;
+  gap: 12px;
+  width: max-content;
+  animation: wdg-marquee-scroll 36s linear infinite;
+}
+.wdg-marquee-rev { animation-direction: reverse; animation-duration: 30s; }
+.wdg-marquee:hover .wdg-marquee-track { animation-play-state: paused; }
+.wdg-marquee-item { flex: 0 0 auto; width: 268px; padding: 12px; }
+@keyframes wdg-marquee-scroll {
+  from { transform: translateX(0); }
+  to { transform: translateX(-50%); }
+}
+
+/* Orbit centre card entrance */
+.wdg-orbit-card {
+  animation: wdg-fade-up 0.35s ease;
+  box-shadow: 0 14px 30px -16px rgba(22, 26, 46, 0.22);
+}
+.wdg-orbit-avatar { z-index: 1; }
+.wdg-orbit-avatar:focus-visible { outline: 2px solid var(--accent, #7c6fe0); }
+@keyframes wdg-fade-up {
+  from { opacity: 0; transform: translateY(8px); }
+  to { opacity: 1; transform: translateY(0); }
+}
diff --git a/client/src/widgets/designs/carousel.tsx b/client/src/widgets/designs/carousel.tsx
new file mode 100644
index 0000000..2ec355e
--- /dev/null
+++ b/client/src/widgets/designs/carousel.tsx
@@ -0,0 +1,78 @@
+/** Carousel — one review at a time, auto-rotates, pauses on hover, dot nav. */
+import { useEffect, useState } from 'react';
+import type { WidgetDesignProps } from '../types';
+import { Avatar, StarsInline, timeLabel, WidgetEmpty, fontStack } from '../primitives';
+
+const INTERVAL_MS = 4800;
+
+export default function CarouselWidget({ items, tokens, cta }: WidgetDesignProps) {
+  const [idx, setIdx] = useState(0);
+  const [paused, setPaused] = useState(false);
+
+  useEffect(() => {
+    if (paused || items.length < 2) return;
+    const t = window.setInterval(() => setIdx((i) => (i + 1) % items.length), INTERVAL_MS);
+    return () => window.clearInterval(t);
+  }, [paused, items.length]);
+
+  if (items.length === 0) return <WidgetEmpty tokens={tokens} cta={cta} />;
+  const item = items[Math.min(idx, items.length - 1)];
+
+  return (
+    <div
+      style={{ fontFamily: fontStack(tokens.font), maxWidth: 680, margin: '0 auto' }}
+      onMouseEnter={() => setPaused(true)}
+      onMouseLeave={() => setPaused(false)}
+    >
+      <div
+        style={{
+          background: '#fff',
+          border: `1px solid ${tokens.primary}22`,
+          borderRadius: tokens.radiusPx,
+          padding: '30px 26px',
+          textAlign: 'center',
+          display: 'flex',
+          flexDirection: 'column',
+          alignItems: 'center',
+          gap: 12,
+          minHeight: 250,
+          justifyContent: 'center',
+        }}
+      >
+        <Avatar item={item} tokens={tokens} size={52} />
+        <StarsInline rating={item.rating} size={18} />
+        <blockquote style={{ margin: 0, fontSize: 16, lineHeight: 1.6, color: '#2b2f45', maxWidth: 500 }}>{item.content}</blockquote>
+        <div style={{ fontWeight: 700, color: tokens.primary }}>{item.authorName}</div>
+        <div style={{ fontSize: 12, color: '#9aa0b0' }}>{timeLabel(item.createdAt)}</div>
+      </div>
+
+      <div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', gap: 6, marginTop: 12 }}>
+        {items.slice(0, 8).map((it, i) => (
+          <button
+            key={it.id}
+            type="button"
+            aria-label={`Review ${i + 1}`}
+            onClick={() => setIdx(i)}
+            style={{
+              width: i === idx ? 18 : 7,
+              height: 7,
+              borderRadius: 4,
+              border: 0,
+              background: i === idx ? tokens.primary : tokens.primary + '44',
+              cursor: 'pointer',
+              transition: 'width .2s ease',
+              padding: 0,
+            }}
+          />
+        ))}
+      </div>
+      <div style={{ textAlign: 'center', marginTop: 12 }}>
+        {cta && (

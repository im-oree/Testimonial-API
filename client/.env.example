# ── Web app (Vite) configuration ────────────────────────────────────────────
# Copy this file to client/.env and adjust. Every value has a sane default —
# the app runs with NO .env file at all.
#
#   cp .env.example .env
#
# Only variables prefixed VITE_ are exposed to the browser (Vite convention).

# Where the browser sends API calls.
#   unset/empty  — same origin (/v1/...). In dev, Vite proxies those requests
#                  to the API (see VITE_API_PROXY_TARGET). This is the default
#                  and needs zero setup.
#   absolute URL — for a DEPLOYED frontend pointing at a separate API, e.g.
#                  VITE_API_BASE=https://api.example.com  (enable CORS on the
#                  server with CORS_ORIGINS in server/.env)
#VITE_API_BASE=

# Where the Vite DEV server forwards /v1 and /health requests. Change this if
# your API runs on a different port locally (PORT in server/.env).
# default: http://127.0.0.1:3000
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Port of the Vite dev server itself.
# default: 3001
VITE_PORT=3001
